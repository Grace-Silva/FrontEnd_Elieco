# Variables VITE_* son PÚBLICAS (quedan dentro del código del navegador). Nunca pongas secretos aquí.
# URL base del backend Express (sin "/" final)
VITE_API_URL=http://localhost:5000
# WhatsApp de la empresa en formato internacional, solo dígitos. Ejemplo: 573001234567
VITE_WHATSAPP_NUMBER=573002108134
